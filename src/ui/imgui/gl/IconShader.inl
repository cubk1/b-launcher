R"GLSL(                    float box(vec2 p, vec2 a, vec2 b) {
    vec2 c = (a + b) * 0.5;
    vec2 q = abs(p - c) - (b - a) * 0.5;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

float cover(float sd) {
    float aa = max(fwidth(sd), 1e-5);
    return clamp(0.5 - sd / aa, 0.0, 1.0);
}

vec4 over(vec4 dst, vec3 color, float alpha) {
    return vec4(color * alpha + dst.rgb * (1.0 - alpha), alpha + dst.a * (1.0 - alpha));
}

