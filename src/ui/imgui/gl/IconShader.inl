R"GLSL(                    float polyClaude(vec2 p) {
    float d = 1e9;
    int w = 0;
    int start = 0;
    for (int s = 0; s < CLAUDE_ENDS.length(); s++) {
        int end = CLAUDE_ENDS[s];
        for (int i = start; i < end; i++) {
            vec2 a = CLAUDE[i];
            vec2 b = CLAUDE[i + 1 == end ? start : i + 1];
            vec2 e = b - a;
            vec2 pa = p - a;
            vec2 q = pa - e * clamp(dot(pa, e) / dot(e, e), 0.0, 1.0);
            d = min(d, dot(q, q));
            float c = e.x * pa.y - e.y * pa.x;
            if (a.y <= p.y) {
                if (b.y > p.y && c > 0.0) {
                    w++;
                }
            } else if (b.y <= p.y && c < 0.0) {
                w--;
            }
        }
        start = end;
    }
    return (w != 0 ? -1.0 : 1.0) * sqrt(d);
}

float polyCodex(vec2 p) {
    float d = 1e9;
    int w = 0;
    int start = 0;
    for (int s = 0; s < CODEX_ENDS.length(); s++) {
        int end = CODEX_ENDS[s];
        for (int i = start; i < end; i++) {
            vec2 a = CODEX[i];
            vec2 b = CODEX[i + 1 == end ? start : i + 1];
            vec2 e = b - a;
            vec2 pa = p - a;
            vec2 q = pa - e * clamp(dot(pa, e) / dot(e, e), 0.0, 1.0);
            d = min(d, dot(q, q));
            float c = e.x * pa.y - e.y * pa.x;
            if (a.y <= p.y) {
                if (b.y > p.y && c > 0.0) {
                    w++;
                }
            } else if (b.y <= p.y && c < 0.0) {
                w--;
            }
        }
        start = end;
    }
    return (w != 0 ? -1.0 : 1.0) * sqrt(d);
}

