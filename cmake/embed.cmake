function(embed_files)
    cmake_parse_arguments(PARSE_ARGV 0 EMBED "" "OUTPUT;HEADER;NAMESPACE" "FILES")
    string(REPEAT "0x..," 32 line)
    set(text "#include \"${EMBED_HEADER}\"\n\nnamespace ${EMBED_NAMESPACE} {\n")
    list(LENGTH EMBED_FILES count)
    math(EXPR last "${count} - 1")
    foreach (index RANGE 0 ${last} 2)
        math(EXPR next "${index} + 1")
        list(GET EMBED_FILES ${index} symbol)
        list(GET EMBED_FILES ${next} file)
        get_filename_component(file "${file}" ABSOLUTE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" digits)
        math(EXPR size "${digits} / 2")
        string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(${line})" "\\1\n        " bytes "${bytes}")
        string(REGEX REPLACE "\n *$" "" bytes "${bytes}")
        string(APPEND text "\n    alignas(4) const unsigned char ${symbol}[${size}] = {\n        ${bytes}\n    };\n"
                "    const unsigned int ${symbol}Size = ${size};\n")
    endforeach ()
    string(APPEND text "}\n")
    if (EXISTS "${EMBED_OUTPUT}")
        file(READ "${EMBED_OUTPUT}" written)
        if ("${written}" STREQUAL "${text}")
            return()
        endif ()
    endif ()
    file(WRITE "${EMBED_OUTPUT}" "${text}")
endfunction()
