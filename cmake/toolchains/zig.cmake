if (NOT DEFINED BLB_ZIG_TARGET)
    message(FATAL_ERROR "Use one of the zig-<system>-<arch>.cmake toolchain files")
endif ()

set(CMAKE_SYSTEM_NAME ${BLB_ZIG_SYSTEM})
set(CMAKE_SYSTEM_PROCESSOR ${BLB_ZIG_PROCESSOR})
if (BLB_ZIG_SYSTEM STREQUAL "Linux")
    set(CMAKE_LIBRARY_ARCHITECTURE ${BLB_ZIG_PROCESSOR}-linux-gnu)
endif ()

if (CMAKE_HOST_WIN32)
    set(BLB_ZIG_SUFFIX .cmd)
else ()
    set(BLB_ZIG_SUFFIX "")
endif ()
set(BLB_ZIG_WRAPPERS ${CMAKE_CURRENT_LIST_DIR}/zig)
set(CMAKE_C_COMPILER ${BLB_ZIG_WRAPPERS}/zig-cc${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_CXX_COMPILER ${BLB_ZIG_WRAPPERS}/zig-c++${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_OBJC_COMPILER ${BLB_ZIG_WRAPPERS}/zig-cc${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_OBJCXX_COMPILER ${BLB_ZIG_WRAPPERS}/zig-c++${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_AR ${BLB_ZIG_WRAPPERS}/zig-ar${BLB_ZIG_SUFFIX})
set(CMAKE_RANLIB ${BLB_ZIG_WRAPPERS}/zig-ranlib${BLB_ZIG_SUFFIX})
if (BLB_ZIG_SYSTEM STREQUAL "Darwin")
    find_program(BLB_INSTALL_NAME_TOOL NAMES llvm-install-name-tool install_name_tool)
    if (BLB_INSTALL_NAME_TOOL)
        set(CMAKE_INSTALL_NAME_TOOL ${BLB_INSTALL_NAME_TOOL})
    else ()
        set(CMAKE_INSTALL_NAME_TOOL ${BLB_ZIG_WRAPPERS}/zig-ranlib${BLB_ZIG_SUFFIX})
    endif ()
endif ()

if (NOT BLB_SYSROOT AND DEFINED ENV{BLB_SYSROOT})
    set(BLB_SYSROOT $ENV{BLB_SYSROOT})
endif ()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES BLB_SYSROOT)
if (BLB_SYSROOT)
    set(CMAKE_SYSROOT ${BLB_SYSROOT})
    set(CMAKE_FIND_ROOT_PATH ${BLB_SYSROOT})
    if (BLB_ZIG_SYSTEM STREQUAL "Linux")
        if (CMAKE_HOST_WIN32)
            set(BLB_PATH_SEPARATOR ";")
        else ()
            set(BLB_PATH_SEPARATOR ":")
        endif ()
        set(ENV{PKG_CONFIG_SYSROOT_DIR} ${BLB_SYSROOT})
        set(ENV{PKG_CONFIG_LIBDIR}
                "${BLB_SYSROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/pkgconfig${BLB_PATH_SEPARATOR}${BLB_SYSROOT}/usr/share/pkgconfig")
    endif ()
    if (BLB_ZIG_SYSTEM STREQUAL "Darwin")
        set(CMAKE_OSX_SYSROOT ${BLB_SYSROOT})
        foreach (language C CXX OBJC OBJCXX)
            set(CMAKE_${language}_FLAGS_INIT "-iframework ${BLB_SYSROOT}/System/Library/Frameworks -isystem ${BLB_SYSROOT}/usr/include")
        endforeach ()
        foreach (kind EXE SHARED MODULE)
            set(CMAKE_${kind}_LINKER_FLAGS_INIT "-F${BLB_SYSROOT}/System/Library/Frameworks -L/usr/lib")
        endforeach ()
    endif ()
else ()
    set(CMAKE_FIND_ROOT_PATH ${BLB_ZIG_WRAPPERS}/no-sysroot)
    if (BLB_ZIG_SYSTEM STREQUAL "Darwin")
        set(CMAKE_OSX_SYSROOT "")
    endif ()
endif ()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
