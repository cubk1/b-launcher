if (NOT DEFINED BLB_ZIG_TARGET)
    message(FATAL_ERROR "Use one of the zig-<system>-<arch>.cmake toolchain files")
endif ()

set(CMAKE_SYSTEM_NAME ${BLB_ZIG_SYSTEM})
set(CMAKE_SYSTEM_PROCESSOR ${BLB_ZIG_PROCESSOR})

if (CMAKE_HOST_WIN32)
    set(BLB_ZIG_SUFFIX .cmd)
else ()
    set(BLB_ZIG_SUFFIX "")
endif ()
set(BLB_ZIG_WRAPPERS ${CMAKE_CURRENT_LIST_DIR}/zig)
set(CMAKE_C_COMPILER ${BLB_ZIG_WRAPPERS}/zig-cc${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_CXX_COMPILER ${BLB_ZIG_WRAPPERS}/zig-c++${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_OBJC_COMPILER ${BLB_ZIG_WRAPPERS}/zig-cc${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_OBJCXX_COMPILER ${BLB_ZIG_WRAPPERS}/zig-c++${BLB_ZIG_SUFFIX} -target ${BLB_ZIG_TARGET})
set(CMAKE_AR ${BLB_ZIG_WRAPPERS}/zig-ar${BLB_ZIG_SUFFIX})
set(CMAKE_RANLIB ${BLB_ZIG_WRAPPERS}/zig-ranlib${BLB_ZIG_SUFFIX})

if (NOT BLB_SYSROOT AND DEFINED ENV{BLB_SYSROOT})
    set(BLB_SYSROOT $ENV{BLB_SYSROOT})
endif ()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES BLB_SYSROOT)
if (BLB_SYSROOT)
    set(CMAKE_SYSROOT ${BLB_SYSROOT})
    set(CMAKE_FIND_ROOT_PATH ${BLB_SYSROOT})
    if (BLB_ZIG_SYSTEM STREQUAL "Darwin")
        set(CMAKE_OSX_SYSROOT ${BLB_SYSROOT})
    endif ()
else ()
    set(CMAKE_FIND_ROOT_PATH ${BLB_ZIG_WRAPPERS}/no-sysroot)
    if (BLB_ZIG_SYSTEM STREQUAL "Darwin")
        set(CMAKE_OSX_SYSROOT "")
    endif ()
endif ()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
