if (NOT CONFIG STREQUAL "MinSizeRel")
    return()
endif ()
if (NOT UPX OR NOT EXISTS "${UPX}")
    message(WARNING "UPX not found, so ${FILE} is left uncompressed: install it (scoop install upx) or configure with -DUPX_EXECUTABLE=<path to upx.exe>.")
    return()
endif ()

execute_process(COMMAND "${UPX}" -q -t "${FILE}" RESULT_VARIABLE unpacked OUTPUT_QUIET ERROR_QUIET)
if (NOT unpacked)
    return()
endif ()

file(SIZE "${FILE}" linked)
execute_process(COMMAND "${UPX}" --best --lzma -q "${FILE}" RESULT_VARIABLE failed OUTPUT_QUIET)
if (failed)
    file(REMOVE "${FILE}")
    message(FATAL_ERROR "UPX could not pack ${FILE}")
endif ()
file(SIZE "${FILE}" packed)
math(EXPR percent "${packed} * 100 / ${linked}")
message(STATUS "Packed with UPX: ${linked} -> ${packed} bytes (${percent}%)")
