set(controls "${SOURCE_DIR}/src/Controls.cpp")
file(READ "${controls}" content)
string(REGEX REPLACE "\n[ \t]*pthread_exit\\(0\\);" "" patched "${content}")
if(NOT patched STREQUAL content)
  file(WRITE "${controls}" "${patched}")
endif()

if(NOT COMPILER_ID MATCHES "Clang" OR COMPILER_VERSION VERSION_LESS 18)
  return()
endif()
set(target "${SOURCE_DIR}/ext/ZeroTierOne/node/AES_aesni.cpp")
file(READ "${target}" content)
set(original "${content}")
string(FIND "${content}" "avx512bw,evex512" found)
if(found EQUAL -1)
  string(REPLACE "avx512f,avx512bw\"" "avx512f,avx512bw,evex512\"" content "${content}")
endif()
if(NOT content STREQUAL original)
  file(WRITE "${target}" "${content}")
endif()
